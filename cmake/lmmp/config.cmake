cmake_minimum_required(VERSION 3.20)

include("${CMAKE_CURRENT_LIST_DIR}/ConfigOptions.cmake")
lmmp_read_option_catalog(_lmmp_option_records)

function(lmmp_catalog_find name output_variable)
    set(_found FALSE)
    foreach(_record IN LISTS _lmmp_option_records)
        string(REPLACE "|" ";" _fields "${_record}")
        list(GET _fields 1 _record_name)
        if(_record_name STREQUAL "${name}")
            set(${output_variable} "${_record}" PARENT_SCOPE)
            set(_found TRUE)
            break()
        endif()
    endforeach()
    if(NOT _found)
        set(${output_variable} "" PARENT_SCOPE)
    endif()
endfunction()

function(lmmp_clean_value value output_variable)
    set(_value "${value}")
    if(_value STREQUAL "\"\"")
        set(_value "")
    endif()
    set(${output_variable} "${_value}" PARENT_SCOPE)
endfunction()

function(lmmp_validate_override name value)
    lmmp_catalog_find("${name}" _record)
    if(_record STREQUAL "")
        message(FATAL_ERROR "Unknown LMMP option '${name}'. Use 'list' to show available options.")
    endif()
    string(REPLACE "|" ";" _fields "${_record}")
    list(GET _fields 2 _type)
    if(_type STREQUAL "bool")
        string(TOUPPER "${value}" _bool_value)
        if(NOT "${_bool_value}" MATCHES "^(ON|OFF|TRUE|FALSE|1|0)$")
            message(FATAL_ERROR "${name} expects ON or OFF, got '${value}'.")
        endif()
    endif()
    if(_type STREQUAL "build-type" AND NOT "${value}" MATCHES "^(inherit|Debug|Release|RelWithDebInfo|MinSizeRel)$")
        message(FATAL_ERROR "${name} expects inherit, Debug, Release, or MinSizeRel, got '${value}'.")
    endif()
    if(_type MATCHES "^enum\\(" AND NOT "${value}" STREQUAL "")
        string(REGEX REPLACE "^enum\\((.*)\\)$" "\\1" _choices "${_type}")
        string(REPLACE "," ";" _choices "${_choices}")
        set(_enum_value "${value}")
        if(name STREQUAL "LMMP_ASM" OR name STREQUAL "LMMP_TARGET_SYSTEM")
            string(TOUPPER "${_enum_value}" _enum_value)
        endif()
        if(NOT "${_enum_value}" IN_LIST _choices)
            message(FATAL_ERROR "${name} has invalid value '${value}'. Allowed values: ${_choices}.")
        endif()
    endif()
endfunction()

function(lmmp_show_help)
    message("LMMP 配置工具")
    message("")
    message("用法：")
    message("  cmake -P cmake/lmmp/config.cmake -- help")
    message("  cmake -P cmake/lmmp/config.cmake -- list")
    message("  cmake -P cmake/lmmp/config.cmake -- configure -B <构建目录> [选项]")
    message("")
    message("命令：")
    message("  help / -h / -help    显示帮助")
    message("  list / -l / -list    以树状结构显示选项、类型和默认值")
    message("  configure            配置构建树")
    message("")
    message("configure 参数：")
    message("  -B <目录>            指定构建树目录，默认读取 LMMP_BUILD_DIR")
    message("  --set NAME=VALUE     设置一个 config.options 中声明的选项")
    message("  --generator <名称>   设置 LMMP_GENERATOR 的简写形式")
    message("")
    message("示例：")
    message("  cmake -P cmake/lmmp/config.cmake -- configure -B build")
    message("  cmake -P cmake/lmmp/config.cmake -- configure -B build --set LMMP_BUILD_TYPE=Debug")
    message("  cmake -P cmake/lmmp/config.cmake -- configure -B build --set LMMP_LIBRARY_BUILD_TYPE=Release --set LMMP_TEST_BUILD_TYPE=Debug")
endfunction()

function(lmmp_show_list)
    message("LMMP 可配置选项")
    message("")
    set(_previous_category "")
    foreach(_record IN LISTS _lmmp_option_records)
        string(REPLACE "|" ";" _fields "${_record}")
        list(GET _fields 0 _category)
        list(GET _fields 1 _name)
        list(GET _fields 2 _type)
        list(GET _fields 3 _catalog_default)
        list(GET _fields 4 _description)
        if(NOT _category STREQUAL "${_previous_category}")
            if(_category STREQUAL "build")
                set(_label "构建")
            elseif(_category STREQUAL "targets")
                set(_label "构建目标")
            elseif(_category STREQUAL "library.debug")
                set(_label "库内部行为")
            else()
                set(_label "${_category}")
            endif()
            message("├─ ${_label}")
            set(_previous_category "${_category}")
        endif()
        if(_type MATCHES "^enum\\(")
            string(REGEX REPLACE "^enum\\((.*)\\)$" "\\1" _type_display "${_type}")
            set(_type_display "枚举：${_type_display}")
        elseif(_type STREQUAL "build-type")
            set(_type_display "构建类型：inherit/Debug/Release/RelWithDebInfo/MinSizeRel")
        elseif(_type STREQUAL "bool")
            set(_type_display "布尔：ON/OFF")
        elseif(_type STREQUAL "path")
            set(_type_display "路径")
        else()
            set(_type_display "${_type}")
        endif()
        if(_catalog_default STREQUAL "inherit")
            set(_default_display "inherit（继承 LMMP_BUILD_TYPE）")
        else()
            lmmp_clean_value("${_catalog_default}" _default_display)
            if(_default_display STREQUAL "")
                set(_default_display "空")
            endif()
        endif()
        message("│  ├─ ${_name}")
        message("│  │  类型：${_type_display}")
        message("│  │  默认：${_default_display}")
        message("│  └─ ${_description}")
    endforeach()
endfunction()

if(CMAKE_ARGC LESS 5)
    lmmp_show_help()
    return()
endif()

set(_command "${CMAKE_ARGV4}")
if(_command STREQUAL "-h" OR _command STREQUAL "-help" OR _command STREQUAL "--help" OR _command STREQUAL "help")
    lmmp_show_help()
    return()
endif()
if(_command STREQUAL "-l" OR _command STREQUAL "-list" OR _command STREQUAL "--list" OR _command STREQUAL "list")
    lmmp_show_list()
    return()
endif()
if(NOT _command STREQUAL "configure")
    message(FATAL_ERROR "未知命令 '${_command}'。请使用 help 查看可用命令。")
endif()

set(_build_dir "")
set(_overrides)
math(EXPR _last_arg "${CMAKE_ARGC} - 1")
set(_i 5)
while(_i LESS_EQUAL _last_arg)
    set(_arg "${CMAKE_ARGV${_i}}")
    if(_arg STREQUAL "-B" OR _arg STREQUAL "--build-dir")
        math(EXPR _i "${_i} + 1")
        if(_i GREATER _last_arg)
            message(FATAL_ERROR "${_arg} requires a directory.")
        endif()
        set(_build_dir "${CMAKE_ARGV${_i}}")
    elseif(_arg STREQUAL "--set")
        math(EXPR _i "${_i} + 1")
        if(_i GREATER _last_arg OR NOT "${CMAKE_ARGV${_i}}" MATCHES "^([A-Za-z_][A-Za-z0-9_]*)=(.*)$")
            message(FATAL_ERROR "--set expects NAME=VALUE.")
        endif()
        set(_name "${CMAKE_MATCH_1}")
        set(_value "${CMAKE_MATCH_2}")
        lmmp_validate_override("${_name}" "${_value}")
        list(APPEND _overrides "${_name}=${_value}")
    elseif(_arg MATCHES "^--set=(.*)$")
        set(_assignment "${CMAKE_MATCH_1}")
        if(NOT "${_assignment}" MATCHES "^([A-Za-z_][A-Za-z0-9_]*)=(.*)$")
            message(FATAL_ERROR "--set expects NAME=VALUE.")
        endif()
        set(_name "${CMAKE_MATCH_1}")
        set(_value "${CMAKE_MATCH_2}")
        lmmp_validate_override("${_name}" "${_value}")
        list(APPEND _overrides "${_name}=${_value}")
    elseif(_arg STREQUAL "--generator")
        math(EXPR _i "${_i} + 1")
        if(_i GREATER _last_arg)
            message(FATAL_ERROR "--generator requires a generator name.")
        endif()
        lmmp_validate_override("LMMP_GENERATOR" "${CMAKE_ARGV${_i}}")
        list(APPEND _overrides "LMMP_GENERATOR=${CMAKE_ARGV${_i}}")
    elseif(_arg STREQUAL "-h" OR _arg STREQUAL "-help" OR _arg STREQUAL "--help")
        lmmp_show_help()
        return()
    else()
        message(FATAL_ERROR "未知 configure 参数 '${_arg}'。请使用 help 查看命令行格式。")
    endif()
    math(EXPR _i "${_i} + 1")
endwhile()

if(_build_dir STREQUAL "")
    foreach(_assignment IN LISTS _overrides)
        if(_assignment MATCHES "^LMMP_BUILD_DIR=(.*)$")
            set(_build_dir "${CMAKE_MATCH_1}")
        endif()
    endforeach()
endif()
if(_build_dir STREQUAL "")
    lmmp_catalog_find("LMMP_BUILD_DIR" _build_record)
    string(REPLACE "|" ";" _build_fields "${_build_record}")
    list(GET _build_fields 3 _build_default)
    lmmp_clean_value("${_build_default}" _build_dir)
endif()

set(_generator "")
lmmp_catalog_find("LMMP_GENERATOR" _generator_record)
string(REPLACE "|" ";" _generator_fields "${_generator_record}")
list(GET _generator_fields 3 _generator_default)
lmmp_clean_value("${_generator_default}" _generator)
foreach(_assignment IN LISTS _overrides)
    if(_assignment MATCHES "^LMMP_GENERATOR=(.*)$")
        set(_generator "${CMAKE_MATCH_1}")
    endif()
endforeach()

set(_cmake_args -S "${CMAKE_CURRENT_LIST_DIR}/../.." -B "${_build_dir}" -G "${_generator}" -DCMAKE_BUILD_TYPE=LMMP)
list(APPEND _cmake_args "-DLMMP_BUILD_DIR=${_build_dir}")
foreach(_assignment IN LISTS _overrides)
    list(APPEND _cmake_args "-D${_assignment}")
endforeach()
execute_process(
    COMMAND "${CMAKE_COMMAND}" ${_cmake_args}
    COMMAND_ERROR_IS_FATAL ANY)

